# ==========================================
# YUKTI SOFTWARE - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Maps & Places
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# 2. Firebase Configuration
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 3. EmailJS Configuration
# Get these from EmailJS Dashboard (https://dashboard.emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Template for Admin Notification (Received by Yukti Software team)
VITE_EMAILJS_ADMIN_TEMPLATE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Template for User Auto-Reply / Confirmation (Sent to the student/client who filled the form)
VITE_EMAILJS_USER_TEMPLATE_ID=

# 4. Automated WhatsApp Message Gateway (100% Free Developer Tier)
# Get free instance from Green-API (https://green-api.com) -> Free Developer Plan
VITE_GREEN_API_ID_INSTANCE=
VITE_GREEN_API_TOKEN_INSTANCE=