# ==============================================================================
# Yukti Software - Apache & LiteSpeed SPA Routing Rules (.htaccess)
# Ensures Direct URL access and refreshes (e.g. /about-us/, /courses/, etc.)
# route seamlessly to index.html without 404 Not Found errors.
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If index.html is directly requested, serve it
  RewriteRule ^index\.html$ - [L]

  # 2. If the requested URI is an existing file, folder, or symlink, serve directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # 3. Otherwise, rewrite all requests to index.html with 200 status
  RewriteRule ^.*$ /index.html [L]
</IfModule>

# Prevent directory browsing
Options -Indexes

# Security & Content Type Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

AddDefaultCharset UTF-8
